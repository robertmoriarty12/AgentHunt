{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.1.3",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "secCopilotHunting-Incident-Playbook"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "notificationRecipients": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
    "connAzSentinel": "[concat('azuresentinel-', parameters('workflowName'))]",
    "connSecCopilot": "securitycopilot-1",
    "connOffice365": "office365-1"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connAzSentinel')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[variables('connAzSentinel')]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]"
        },
        "parameterValues": {}
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connSecCopilot')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[variables('connSecCopilot')]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'securitycopilot')]"
        },
        "parameterValues": {}
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connOffice365')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[variables('connOffice365')]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        },
        "parameterValues": {}
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connAzSentinel'))]",
        "[resourceId('Microsoft.Web/connections', variables('connSecCopilot'))]",
        "[resourceId('Microsoft.Web/connections', variables('connOffice365'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation",
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                }
              }
            }
          },
          "actions": {
            "SC-_Incident_Summary": {
              "runAfter": {},
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "@triggerBody()?['object']?['properties']?['providerIncidentId']",
                  "SkillName": "GetIncident",
                  "SkillInputs": "@triggerBody()?['object']?['properties']?['providerIncidentId']"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntProcessInventory": {
              "runAfter": {
                "SC-_Incident_Summary": [
                  "Succeeded",
                  "TimedOut",
                  "Skipped",
                  "Failed"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntProcessInventory",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntProcessInventory"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntTempStaging": {
              "runAfter": {
                "SC-_Run_AgentHuntProcessInventory": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntTempStaging",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntTempStaging"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntRunKeyAutorun": {
              "runAfter": {
                "SC-_Run_AgentHuntTempStaging": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntRunKeyAutorun",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntRunKeyAutorun"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntRegistryLabWrites": {
              "runAfter": {
                "SC-_Run_AgentHuntRunKeyAutorun": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntRegistryLabWrites",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntRegistryLabWrites"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntNetworkRecon": {
              "runAfter": {
                "SC-_Run_AgentHuntRegistryLabWrites": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntNetworkRecon",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntNetworkRecon"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntTestNetProbes": {
              "runAfter": {
                "SC-_Run_AgentHuntNetworkRecon": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntTestNetProbes",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntTestNetProbes"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Run_AgentHuntEicarLifecycle": {
              "runAfter": {
                "SC-_Run_AgentHuntTestNetProbes": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "AgentHuntEicarLifecycle",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']",
                  "SkillName": "AgentHuntEicarLifecycle"
                },
                "path": "/process-prompt"
              }
            },
            "SC-_Build_Report": {
              "runAfter": {
                "SC-_Run_AgentHuntEicarLifecycle": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['securitycopilot']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "PromptContent": "/askgpt Using the current session context, generate an HTML-formatted incident report. Review the incident summary and incorporate the results of all subsequent hunting KQL queries. Write from the perspective of a SOC Analyst preparing an initial incident notification. The report should be suitable for sending via email to the security team and must include:\\n\\nExecutive Summary of the incident\\n\\nKey findings from hunting queries (clearly attributed to data sources). Call out if any hunting findings are contextual to the incident summary.\\n\\nImpact and scope (affected users, assets, timelines)\\n\\nRecommended next steps and actions for the SOC team\\n\\nEnsure the output is in clean, professional HTML formatting that can be directly sent as an email notification",
                  "SessionId": "@body('SC-_Incident_Summary')?['sessionId']"
                },
                "path": "/process-prompt"
              }
            },
            "Send_an_email_(V2)": {
              "runAfter": {
                "SC-_Build_Report": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "To": "@{coalesce(parameters('notificationRecipients'), '')}",
                  "Subject": "New Incident: @{triggerBody()?['object']?['properties']?['title']}",
                  "Body": "<p class=\\\"editor-paragraph\\\">@{body('SC-_Build_Report')?['EvaluationResultContent']}</p>",
                  "Importance": "High"
                },
                "path": "/v2/Mail"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connAzSentinel'))]",
                "connectionName": "[variables('connAzSentinel')]"
              },
              "securitycopilot": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'securitycopilot')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connSecCopilot'))]",
                "connectionName": "[variables('connSecCopilot')]"
              },
              "office365": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connOffice365'))]",
                "connectionName": "[variables('connOffice365')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {}
}
